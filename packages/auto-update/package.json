{
  "name": "@ai-tool-cms/auto-update",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Daily auto-update pipeline for AI tools",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\" --config ../../eslint.config.mjs",
    "test": "vitest run --config ../../vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "crawler:run": "tsx --tsconfig tsconfig.runtime.json src/crawler-cli.ts",
    "tools:auto-update": "tsx --tsconfig tsconfig.runtime.json src/cli.ts",
    "futurepedia:export": "tsx --tsconfig tsconfig.runtime.json ../../scripts/futurepedia/export-futurepedia-all.ts",
    "futurepedia:build-import": "tsx --tsconfig tsconfig.runtime.json ../../scripts/futurepedia/build-futurepedia-import-json.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-tool-cms/cache": "workspace:*",
    "@ai-tool-cms/common": "workspace:*",
    "@ai-tool-cms/config": "workspace:*",
    "@ai-tool-cms/database": "workspace:*",
    "@ai-tool-cms/discovery": "workspace:*",
    "@ai-tool-cms/search": "workspace:*",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
