{
  "name": "ai-tool-cms",
  "version": "1.0.0",
  "private": true,
  "description": "AI 工具内容管理系统 Monorepo",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:stack": "turbo run dev --filter=@ai-tool-cms/web --filter=@ai-tool-cms/api",
    "dev:web": "pnpm --filter @ai-tool-cms/web dev",
    "dev:api": "pnpm --filter @ai-tool-cms/api dev",
    "dev:admin": "pnpm --filter @ai-tool-cms/admin dev",
    "dev:ui": "turbo run dev --filter=@ai-tool-cms/web --filter=@ai-tool-cms/admin",
    "db:generate": "pnpm --filter @ai-tool-cms/database db:generate",
    "db:migrate": "pnpm --filter @ai-tool-cms/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @ai-tool-cms/database db:migrate:deploy",
    "db:studio": "pnpm --filter @ai-tool-cms/database db:studio",
    "db:seed": "pnpm --filter @ai-tool-cms/database db:seed",
    "seed:tools": "pnpm --filter @ai-tool-cms/database exec tsx ../../scripts/seed-production-tools.ts",
    "crawler:run": "pnpm --filter @ai-tool-cms/auto-update crawler:run",
    "crawler:dry-run": "pnpm --filter @ai-tool-cms/auto-update crawler:run --dry-run",
    "futurepedia:export": "pnpm --filter @ai-tool-cms/auto-update futurepedia:export",
    "futurepedia:build-import": "pnpm --filter @ai-tool-cms/auto-update futurepedia:build-import",
    "futurepedia:import-server": "node scripts/futurepedia/import-futurepedia-tools-to-server.mjs",
    "futurepedia:verify-import": "node scripts/futurepedia/verify-futurepedia-import.mjs",
    "tools:export-snapshot": "node scripts/tools/export-existing-tools-snapshot.mjs",
    "tools:export-all-json": "node scripts/tools/export-all-tools-json.mjs",
    "tools:auto-update:export-review": "node scripts/auto-update/export-review-dataset.mjs",
    "tools:auto-update:validate-review": "node scripts/auto-update/validate-review-dataset.mjs",
    "tools:auto-update:audit-overlaps": "node scripts/auto-update/audit-import-overlaps.mjs",
    "categories:normalize": "pnpm --filter @ai-tool-cms/database exec tsx ../../scripts/database/normalize-categories.ts",
    "tools:auto-update": "pnpm --filter @ai-tool-cms/auto-update tools:auto-update",
    "tools:auto-update:enrich-taaft-canonical": "node scripts/auto-update/enrich-taaft-canonical-import.mjs",
    "tools:auto-update:collect-taaft-local": "node scripts/auto-update/collect-taaft-local.mjs",
    "ops:list-category-counts": "node scripts/ops/list-category-counts.mjs",
    "ops:report-suspicious-tool-categories": "node scripts/ops/report-suspicious-tool-categories.mjs",
    "ops:merge-long-tail-categories": "node scripts/ops/merge-long-tail-categories.mjs",
    "ops:reclassify-uncategorized-tools": "node scripts/ops/reclassify-uncategorized-tools.mjs",
    "ops:fill-missing-taxonomy": "node scripts/ops/fill-missing-taxonomy.mjs",
    "ops:fix-uncategorized-tools": "node scripts/ops/fix-uncategorized-tools.mjs",
    "ops:cleanup-uncategorized-category": "node scripts/ops/cleanup-uncategorized-category.mjs",
    "ops:fill-missing-logos": "node scripts/ops/fill-missing-logos.mjs",
    "ops:verify-uncategorized-fix": "node scripts/ops/verify-uncategorized-fix.mjs",
    "ops:verify-tool-cleanup": "node scripts/ops/verify-tool-cleanup.mjs",
    "ops:verify-missing-logos": "node scripts/ops/verify-missing-logos.mjs",
    "ops:run-taxonomy-cleanup": "node scripts/ops/run-taxonomy-cleanup-flow.mjs",
    "ops:deploy-seo-fixes": "python scripts/ops/deploy-seo-fixes.py",
    "ops:verify-live-seo": "python scripts/ops/verify-live-seo.py",
    "ai:content-suggest": "node scripts/ai/ollama-content-suggest.mjs",
    "ai:build-content-input": "node scripts/ai/build-content-input.mjs",
    "ai:logo-discovery": "node scripts/ai/logo-discovery.mjs",
    "ai:compose-enrichment": "node scripts/ai/compose-content-enrichment.mjs",
    "blog:daily": "node scripts/blog/generate-daily-blogs.mjs",
    "blog:daily:publish": "node scripts/blog/generate-daily-blogs.mjs --publish",
    "blog:daily:verify": "node scripts/blog/verify-daily-blogs.mjs",
    "demo:reset-admin": "pnpm --filter @ai-tool-cms/database exec tsx ../../scripts/database/reset-local-admin.ts",
    "mcp": "pnpm --filter @ai-tool-cms/mcp-server build && pnpm --filter @ai-tool-cms/mcp-server start",
    "mcp:dev": "pnpm --filter @ai-tool-cms/mcp-server dev",
    "setup:env": "node scripts/setup-env.mjs",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "docker:prod:config": "docker compose --env-file .env.production -f docker-compose.prod.yml config",
    "docker:prod:up": "docker compose --env-file .env.production -f docker-compose.prod.yml up -d --wait",
    "docker:prod:down": "docker compose --env-file .env.production -f docker-compose.prod.yml down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint-staged": "lint-staged",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "vitest run --config vitest.config.ts tests/unit packages",
    "test:integration": "vitest run --config vitest.config.ts tests/integration",
    "test:e2e": "playwright test -c tests/playwright.config.ts",
    "audit:prod": "node scripts/audit/production-audit.mjs",
    "backup:postgres": "bash scripts/backup/backup-postgres.sh",
    "backup:verify": "bash scripts/backup/verify-backup.sh",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "@playwright/test": "^1.49.1",
    "turbo": "^2.4.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
